---
import Layout from "../../layouts/Layout.astro";
import { ChevronRight } from "lucide-react";
import { getCollection } from "astro:content";

const posts = await getCollection("blog", ({ data }) => !data.hidden);
---

<Layout title="Posts • vasc.dev" description="Random stuff I want to share">
  <h1 class="mt-3 mb-5 text-4xl font-bold tracking-tight sm:text-5xl">Posts</h1>
  <div class="flex flex-col gap-3">
    {
      posts.map((post) => (
        <a
          class="flex w-full items-center justify-between rounded-md border border-white/20 bg-white/10 px-3 py-4"
          href={`/posts/${post.id}`}
        >
          <div>
            <h2 class="text-xl font-bold">{post.data.title}</h2>
            <p class="text-sm font-light">
              {post.data.description && `${post.data.description} -`}
              <span class="italic">
                {new Date(post.data.date).toLocaleDateString()}
              </span>
            </p>
          </div>
          <ChevronRight className="w-6 h-6" />
        </a>
      ))
    }
    {
      posts.length === 0 && (
        <p class="text-center text-sm text-gray-100">No posts yet 😢</p>
      )
    }
  </div>
</Layout>
